{
  "name": "@haksanlulz/mcp-fairrent",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP (Model Context Protocol) server for HUD housing data: Fair Market Rents, Section 8 income limits, and the USPS ZIP-to-jurisdiction crosswalk.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hud",
    "fair-market-rent",
    "housing",
    "affordable-housing",
    "civic-tech",
    "llm",
    "ai"
  ],
  "license": "MIT",
  "author": "Abishai James",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haksanlulz/mcp-fairrent.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "smoke": "tsx smoke.ts",
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node scripts/pack-probe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "tsx": "^4.20.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-fairrent": "dist/index.js"
  }
}
