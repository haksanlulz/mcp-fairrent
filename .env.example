# mcp-fairrent environment variables. Nothing auto-loads a .env file --
# set these in the shell or in the MCP client's "env" block (see README).

# Required by every tool. Free token, one-screen signup:
# https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_TOKEN=

# Optional. Contact string for the User-Agent sent to HUD;
# defaults to this repo's URL.
HUD_CONTACT=
