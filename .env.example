# mcp-fairrent environment variables. Nothing auto-loads a .env file --
# set these in the shell or in the MCP client's "env" block (see README).

# Required by every tool. Free token, one-screen signup:
# https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_TOKEN=

# Optional. Contact string for the User-Agent sent to HUD;
# defaults to this repo's URL.
HUD_CONTACT=

# Optional tuning. Each takes a whole number; anything else, or a value outside
# the stated range, falls back to the default below and logs one line to stderr.

# Attempts per HUD request, 1-10. Only 429, 5xx and transport errors are
# retried. Default 3.
HUD_HTTP_ATTEMPTS=

# Response-cache lifetime in milliseconds. 0 turns the cache off.
# Default 86400000 (24h; HUD publishes these tables annually).
HUD_CACHE_TTL_MS=

# Most responses kept in the cache before the oldest is dropped. Default 300.
HUD_CACHE_MAX=
